# Ignore rules for public/self-hosted/Dockerfile builds (BuildKit resolves
# <Dockerfile>.dockerignore next to the Dockerfile). The build context is the private monorepo
# root; keep this whitelist in sync with the COPY statements in the Dockerfile.
*
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!crates/
!crates/**
crates/*/testdata/
crates/*/testdata/**
crates/scanner/grammars/
crates/scanner/grammars/**
!public/self-hosted/Caddyfile
!public/self-hosted/entrypoint.sh
!rules/
!rules/**
crates/server/ui/node_modules/
crates/server/ui/node_modules/**
crates/server/ui/.pnpm-store/
crates/server/ui/.pnpm-store/**
crates/server/ui/build/
crates/server/ui/build/**
crates/server/ui/.react-router/
crates/server/ui/.react-router/**

# HoundDog.ai Self-Hosted configuration.
#
# You can run ./install.sh to generate a .env file interactively, or copy this file to .env and fill in the
# values yourself. IMPORTANT: Keep the .env file safe and private as it contains secrets.

# ----------------------------------------------------------------------------------------------------------
# Required
# ----------------------------------------------------------------------------------------------------------
# Stable random string of 50+ characters used to encrypt sensitive data at rest.
# Generate one with: openssl rand -base64 48
# Keep a copy somewhere safe. Changing or losing it makes encrypted settings unrecoverable.
HOUNDDOG_SECRET_KEY=

# Random key required to create the first owner.
# Generate one with: openssl rand -base64 48
# Keep it private and paste it only into the first-run setup form.
HOUNDDOG_SETUP_KEY=

# ----------------------------------------------------------------------------------------------------------
# Database (pick one of the two options)
# ----------------------------------------------------------------------------------------------------------

# Option 1: bundled Postgres managed by Docker Compose (recommended for local testing).
# These defaults make local testing quick. For any non-local deployment, change the user,
# password, and database before the first start. Existing Postgres volumes keep their original
# credentials, so changing these values later does not update an initialized database.
# These values are interpolated into the database URL. Use only ASCII letters, numbers, hyphens,
# periods, underscores, and tildes; do not use other special characters such as /, ?, or %.
COMPOSE_PROFILES=postgres
POSTGRES_USER=hounddog
POSTGRES_PASSWORD=hounddog
POSTGRES_DB=hounddog
HOUNDDOG_POSTGRES_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Option 2: bring-your-own Postgres (recommended for production).
# Remove the bundled Postgres settings above and replace HOUNDDOG_POSTGRES_URL with your
# provider's connection URL.
#HOUNDDOG_POSTGRES_URL=postgres://user:password@host:5432/database

# ----------------------------------------------------------------------------------------------------------
# Optional
# ----------------------------------------------------------------------------------------------------------

# Port published by the starter Compose stack. The default public URL follows this port.
#HOUNDDOG_PORT=3300

# Leave unset to publish the port on all IPv4 and IPv6 interfaces. Set 127.0.0.1 to restrict access to this host.
#HOUNDDOG_BIND_ADDRESS=127.0.0.1

# Public HTTP or HTTPS origin, without a path. The API is served at HOUNDDOG_URL/api.
# Set this when using a domain or reverse proxy. A trailing slash is allowed and removed.
#HOUNDDOG_URL=http://localhost:3300

# Set to 1 to serve the API reference at HOUNDDOG_URL/api-docs, with its OpenAPI document at
# HOUNDDOG_URL/api/openapi.json.
#HOUNDDOG_API_DOCS=0

# Sign-in, first-run setup, and password change attempts allowed per client IP address within the window (a duration
# such as 30s, 1m, or 5m). Further attempts get HTTP 429 and "Too many attempts. Try again in a minute." until older
# attempts leave the window. All addresses in one IPv6 /64 network count as one client.
#HOUNDDOG_AUTH_RATE_LIMIT_EVENTS=10
#HOUNDDOG_AUTH_RATE_LIMIT_WINDOW=1m

# Space-separated IP addresses or CIDR ranges of your own reverse proxies or load balancers, or private_ranges for all
# private networks. Requests from these proxies count against the client address they report in X-Forwarded-For.
# Set this when HoundDog.ai runs behind a proxy, or all clients share the proxy's sign-in limit. Leave it unset when
# clients connect directly, because a trusted address can claim to send requests for any client.
# A proxy on this host connects through the Docker network's gateway, not from 127.0.0.1, and the gateway's address
# can change when the stack is recreated. For such a proxy, set HOUNDDOG_BIND_ADDRESS=127.0.0.1 so that only this host
# can connect, and set HOUNDDOG_TRUSTED_PROXIES=private_ranges.
# Docker reports its gateway instead of the client address for IPv6 clients that connect directly, and for all clients
# on Docker Desktop or rootless Docker, so those clients share one limit unless a reverse proxy sits in front.
#HOUNDDOG_TRUSTED_PROXIES=10.0.0.0/8

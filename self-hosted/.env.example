# HoundDog.ai self-hosted configuration, read by compose.yaml.
# Run ./setup.sh to generate a .env file interactively, or copy this file to .env and fill in
# the values. Keep .env private: it contains secrets.

# ----------------------------------------------------------------------------------------------
# Required
# ----------------------------------------------------------------------------------------------

# Stable random string of 50+ characters used to encrypt sensitive data at rest. Generate one
# with: openssl rand -base64 48
# Keep a copy somewhere safe. Changing or losing it makes encrypted settings unrecoverable.
HOUNDDOG_SECRET_KEY=

# ----------------------------------------------------------------------------------------------
# Database (pick one of the two options)
# ----------------------------------------------------------------------------------------------

# Option 1 (default): bundled Postgres managed by this compose stack.
COMPOSE_PROFILES=postgres
HOUNDDOG_POSTGRES_PASSWORD=hounddog

# Option 2: external Postgres. Set the URL below and remove the COMPOSE_PROFILES line above so
# the bundled database does not start.
#HOUNDDOG_POSTGRES_URL=postgres://user:password@host:5432/hounddog

# ----------------------------------------------------------------------------------------------
# Optional
# ----------------------------------------------------------------------------------------------

# Ports published by the starter Compose stack.
#HOUNDDOG_APP_PORT=3300
#HOUNDDOG_API_PORT=8800

# URLs your users' browsers will reach; required when not accessing via localhost.
# When omitted, localhost URLs are derived from the ports above.
#HOUNDDOG_APP_BASE_URL=http://localhost:3300
#HOUNDDOG_API_BASE_URL=http://localhost:8800

# Bring your own LLM API key to enable AI features.
#HOUNDDOG_ENABLE_AI=1
#HOUNDDOG_GEMINI_API_KEY=
#HOUNDDOG_AWS_BEDROCK_API_KEY=
